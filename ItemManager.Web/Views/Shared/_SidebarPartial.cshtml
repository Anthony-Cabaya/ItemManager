@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var username = Context.Session.GetString("Username") ?? "";
    var role = Context.Session.GetString("Role") ?? "";

    var avatar = username.Length >= 2
        ? username.Substring(0, 2).ToUpper()
        : username.ToUpper();
}

<aside id="sidebar" class="d-flex flex-column">

    <!-- HEADER -->
    <div class="sb-header">
        <div class="sb-logo">
            <span>📦</span>
            <span class="sb-logo-text">ItemManager</span>
        </div>

        <button id="sidebarCloseBtn"
                class="btn-close d-md-none"
                aria-label="Close">
        </button>
    </div>

    <!-- NAV -->
    <nav class="sb-nav">

        <a asp-controller="Dashboard" asp-action="Index"
           class="nav-item @(ctrl == "Dashboard" ? "active" : "")">
            <span class="nav-icon">📊</span>
            <span class="nav-label">Dashboard</span>
        </a>

        <div class="sb-divider"></div>

        <a asp-controller="Item" asp-action="Index"
           class="nav-item @(ctrl == "Item" ? "active" : "")">
            <span class="nav-icon">📦</span>
            <span class="nav-label">Items</span>
        </a>

        <div class="sb-divider"></div>

        @if (role == "Admin")
        {
            <div class="nav-section-label">Configuration</div>

            <a asp-controller="ItemType" asp-action="Index"
               class="nav-item @(ctrl == "ItemType" ? "active" : "")">
                <span class="nav-icon">🏷️</span>
                <span class="nav-label">Item Types</span>
            </a>

            <a asp-controller="ItemSubType" asp-action="Index"
               class="nav-item @(ctrl == "ItemSubType" ? "active" : "")">
                <span class="nav-icon">🔖</span>
                <span class="nav-label">Sub Types</span>
            </a>

            <a asp-controller="Unit" asp-action="Index"
               class="nav-item @(ctrl == "Unit" ? "active" : "")">
                <span class="nav-icon">⚖️</span>
                <span class="nav-label">Units</span>
            </a>

            <div class="sb-divider"></div>
        }
    </nav>

    <!-- FOOTER -->
    <div class="sb-footer">

        <div class="d-flex align-items-center gap-2">
            <div class="sb-avatar">
                @avatar
            </div>

            <div>
                <div class="sb-user">@username</div>
                <div class="sb-role">@role</div>
            </div>
        </div>

        <form asp-controller="Login" asp-action="Logout" method="post" class="mt-2">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                Logout
            </button>
        </form>

    </div>

</aside>