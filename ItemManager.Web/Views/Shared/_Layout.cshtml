<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ItemManager.Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ItemManager.Web.styles.css" asp-append-version="true" />
</head>
<body>

    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Login")
    {
        <main class="p-4">
            @RenderBody()
        </main>
    }
    else
    {
        <div id="appWrapper">

            @await Html.PartialAsync("_SidebarPartial")

            <div id="mainContent">

                <header class="topbar">
                    <button id="hamburger" class="btn btn-outline-secondary btn-sm">
                        ☰
                    </button>

                    <span class="fw-semibold">
                        @ViewData["Title"]
                    </span>
                </header>

                <main class="p-4">
                    @RenderBody()
                </main>

            </div>

        </div>
    }

    <!-- Mobile overlay -->
    <div id="sidebarOverlay"></div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>