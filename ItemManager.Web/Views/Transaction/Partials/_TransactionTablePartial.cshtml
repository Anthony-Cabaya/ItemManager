@model List<ItemManager.Web.ViewModels.TransactionLogViewModel>

<div style="overflow-x:auto;">

    <table class="table table-hover table-bordered align-middle table-sm"
           style="font-size:13px;">

        <thead class="table-light">

            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Item Code</th>
                <th>Item Name</th>
                <th>Location</th>
                <th>Quantity</th>
                <th>Reference Note</th>
                <th>Created By</th>
                <th>Created Date</th>
            </tr>

        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var badgeClass = item.TransactionType switch
                    {
                        "StockIn" => "bg-success",
                        "StockOut" => "bg-danger",
                        "Hold" => "bg-warning text-dark",
                        "ReleaseHold" => "bg-info text-dark",
                        _ => "bg-secondary"
                    };

                    <tr class="transaction-row"
                        data-id="@item.TransactionID"
                        data-item-id="@item.ItemID"
                        data-location-id="@item.LocationID"
                        data-item-name="@item.ItemName"
                        data-item-code="@item.ItemCode"
                        data-location-name="@item.LocationName"
                        data-quantity="@item.Quantity"
                        data-type="@item.TransactionType">

                        <td>
                            @item.TransactionDate.ToString("yyyy-MM-dd HH:mm")
                        </td>

                        <td>
                            <span class="badge @badgeClass">
                                @item.TransactionType
                            </span>
                        </td>

                        <td>
                            @item.ItemCode
                        </td>

                        <td>
                            @item.ItemName
                        </td>

                        <td>
                            @item.LocationName
                        </td>

                        <td>
                            @item.Quantity
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.ReferenceNote)
                                                ? "-"
                                                : item.ReferenceNote)
                                                                 </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.CreatedBy)
                                                ? "-"
                                                : item.CreatedBy)
                </td>

                        <td>
                            @(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                        </td>

                    </tr>
                        }
            }
            else
            {
                <tr>

                    <td colspan="9"
                        class="text-center text-muted py-4">

                        No transactions found.

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>