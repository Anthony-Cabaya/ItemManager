<div class="modal fade"
     id="stockOutModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    STOCK OUT
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                @Html.AntiForgeryToken()

                <div class="alert alert-danger d-none mb-3"
                     id="stock-out-error">
                </div>

                <input type="hidden" id="stock-out-item-id" />
                <input type="hidden" id="stock-out-location-id" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Item
                    </label>

                    <div class="form-control bg-light"
                         id="stock-out-item-display">
                    </div>
                </div>

                <div class="mb-3"
                     id="stockout-variant-wrapper"
                     style="display:none">

                    <label class="form-label fw-semibold">
                        Variant
                    </label>

                    <select class="form-select form-select-sm"
                            id="stockout-variant-id">

                        <option value="">
                            -- Select Variant --
                        </option>

                    </select>

                    <div id="stockout-variant-error"
                         class="text-danger small mt-1"
                         style="visibility:hidden">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Location
                    </label>

                    <div class="form-control bg-light"
                         id="stock-out-location-display">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Available Quantity
                    </label>

                    <div class="form-control bg-light"
                         id="stock-out-available-display">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Quantity
                    </label>

                    <input type="number"
                           class="form-control"
                           id="stock-out-quantity"
                           min="0.0001"
                           step="0.0001"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Reference Note
                    </label>

                    <textarea class="form-control"
                              id="stock-out-note"
                              rows="3"></textarea>
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    CANCEL
                </button>

                <button type="button"
                        class="btn btn-danger"
                        id="btn-confirm-stock-out">
                    CONFIRM
                </button>

            </div>

        </div>

    </div>

</div>