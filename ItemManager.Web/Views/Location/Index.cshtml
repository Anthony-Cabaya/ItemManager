@model ItemManager.Core.Helpers.PagedResult<ItemManager.Web.ViewModels.LocationViewModel>

@{
    ViewData["Title"] = "Locations";
}

@Html.AntiForgeryToken()

<div class="container-fluid px-4">

    <h4 class="fw-bold text-uppercase mb-3">
        Location Management
    </h4>

    <!-- SEARCH ROW -->
    <div class="d-flex gap-2 align-items-center mb-2 flex-wrap">

        <div class="position-relative" style="width:250px;">

            <input type="text"
                   id="location-search"
                   class="form-control form-control-sm"
                   placeholder="Search locations..."
                   value="@Context.Request.Query["search"]" />

            <span id="clear-search"
                  style="position:absolute;
                         right:8px;
                         top:50%;
                         transform:translateY(-50%);
                         cursor:pointer;
                         display:none;
                         color:#999;">
                ✕
            </span>

        </div>

        <button class="btn btn-outline-secondary btn-sm"
                id="btn-search">
            Search
        </button>

    </div>

    <!-- ACTION ROW -->
    <div class="d-flex gap-2 align-items-center mb-3">

        <button class="btn btn-primary btn-sm"
                id="btn-create-location">
            CREATE
        </button>

        <button class="btn btn-warning btn-sm"
                id="btn-edit-location"
                disabled>
            EDIT
        </button>

        <button class="btn btn-danger btn-sm"
                id="btn-delete-location"
                disabled>
            DELETE
        </button>

        <span id="selectedCount"
              class="text-muted small ms-2">
        </span>

    </div>

    <!-- TABLE -->
    <div style="overflow-x:auto;">

        <table class="table table-hover table-bordered align-middle table-sm"
               style="font-size:13px;">

            <thead class="table-light">

                <tr>
                    <th style="width:36px;">
                        <input type="checkbox" id="selectAll" />
                    </th>
                    <th>Location Name</th>
                    <th>Status</th>
                    <th>Sort</th>
                    <th class="audit-col">Created By</th>
                    <th class="audit-col">Created Date</th>
                    <th class="audit-col">Updated By</th>
                    <th class="audit-col">Updated Date</th>
                </tr>

            </thead>

            <tbody>

                @if (Model?.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="location-row"
                            data-id="@item.LocationID"
                            data-name="@item.LocationName"
                            data-is-active="@item.IsActive.ToString().ToLower()"
                            data-sort="@item.Sort">

                            <td>
                                <input type="checkbox"
                                       class="row-checkbox"
                                       value="@item.LocationID" />
                            </td>

                            <td>@item.LocationName</td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>

                            <td>@item.Sort</td>

                            <td class="audit-col">@item.CreatedBy</td>
                            <td class="audit-col">@item.CreatedDate?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="audit-col">@item.UpdatedBy</td>
                            <td class="audit-col">@item.UpdatedDate?.ToString("yyyy-MM-dd HH:mm")</td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8"
                            class="text-center text-muted py-4">
                            No records found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- PAGINATION -->
    @if (Model != null && Model.TotalPages > 0)
    {
        <div class="text-center mt-2 mb-3">

            <nav>
                <ul class="pagination pagination-sm justify-content-center mb-1">

                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <button class="page-link" id="btn-prev-page">Previous</button>
                    </li>

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <button class="page-link page-number-btn"
                                    data-page="@p">
                                @p
                            </button>
                        </li>
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <button class="page-link" id="btn-next-page">Next</button>
                    </li>

                </ul>
            </nav>

            <span class="text-muted small">
                Showing page @Model.PageNumber of @Model.TotalPages
                (@Model.TotalCount total records)
            </span>

        </div>
    }

</div>

@await Html.PartialAsync("Partials/_CreateLocationModal")
@await Html.PartialAsync("Partials/_EditLocationModal")
@await Html.PartialAsync("Partials/_DeleteLocationModal")

@section Scripts {

    <script src="~/js/shared/fetch-helper.js" asp-append-version="true"></script>
    <script src="~/js/shared/toast.js" asp-append-version="true"></script>
    <script src="~/js/shared/modal-helper.js" asp-append-version="true"></script>

    <script src="~/js/locations/location-state.js" asp-append-version="true"></script>
    <script src="~/js/locations/location-table.js" asp-append-version="true"></script>
    <script src="~/js/locations/location-toolbar.js" asp-append-version="true"></script>
    <script src="~/js/locations/location-modals.js" asp-append-version="true"></script>
    <script src="~/js/locations/location-init.js" asp-append-version="true"></script>

}