<div class="modal fade" id="deleteLocationModal">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">DELETE LOCATION</h5>
            </div>

            <div class="modal-body">

                @Html.AntiForgeryToken()

                <p>Are you sure you want to delete <strong id="delete-location-name"></strong>?</p>

                <input type="hidden" id="delete-location-id" />

                <div id="delete-location-error" class="text-danger d-none"></div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">CANCEL</button>
                <button class="btn btn-danger btn-sm" id="btn-confirm-delete-location">DELETE</button>
            </div>

        </div>
    </div>
</div>