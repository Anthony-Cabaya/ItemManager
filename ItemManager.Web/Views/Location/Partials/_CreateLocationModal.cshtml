<div class="modal fade" id="createLocationModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">CREATE LOCATION</h5>
            </div>

            <div class="modal-body">

                <div class="alert alert-danger d-none mb-3" id="create-location-error"></div>

                @Html.AntiForgeryToken()

                <div class="mb-2">
                    <label>Location Name</label>
                    <input type="text" class="form-control form-control-sm" id="create-location-name" required />
                </div>

                <div class="mb-2">
                    <label>Description</label>
                    <textarea class="form-control form-control-sm" id="create-location-description"></textarea>
                </div>

                <div class="form-check mb-2">
                    <input type="checkbox" class="form-check-input" id="create-location-isactive" checked />
                    <label class="form-check-label">Is Active</label>
                </div>

                <div class="mb-2">
                    <label>Sort</label>
                    <input type="number" class="form-control form-control-sm" id="create-location-sort" value="0" />
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">CANCEL</button>
                <button class="btn btn-primary btn-sm" id="btn-save-location">SAVE</button>
            </div>

        </div>
    </div>
</div>