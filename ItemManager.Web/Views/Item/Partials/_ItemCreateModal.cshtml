<div class="modal fade" id="createModal"
     tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Item</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body">

                <!-- Basic Info -->
                <div class="card mb-3">
                    <div class="card-header fw-semibold">
                        Basic Info
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">
                                Item Name <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="create_itemName"
                                   class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Sort</label>
                            <input type="number"
                                   id="create_sort"
                                   class="form-control"
                                   value="0" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">
                                Item Code
                            </label>
                            <input type="text"
                                   id="create_itemCode"
                                   class="form-control"
                                   placeholder="Auto-generated" />
                            <small class="text-muted">
                                Leave blank to auto-generate,
                                or type to override.
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Classification -->
                <div class="card mb-3">
                    <div class="card-header fw-semibold">
                        Classification
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">
                                Item Type <span class="text-danger">*</span>
                            </label>
                            <select id="create_itemType"
                                    class="form-select">
                                <option value="">
                                    -- Select Item Type --
                                </option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">
                                Sub Type
                            </label>
                            <select id="create_subType"
                                    class="form-select"
                                    disabled>
                                <option value="">
                                    -- Select Sub Type --
                                </option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Measurement -->
                <div class="card mb-3">
                    <div class="card-header fw-semibold">
                        Measurement
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">
                                Base Unit
                            </label>
                            <select id="create_baseUnit"
                                    class="form-select">
                                <option value="">-- No Unit --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">
                                Display Unit
                            </label>
                            <select id="create_displayUnit"
                                    class="form-select">
                                <option value="">-- No Unit --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Details -->
                <div class="card mb-3">
                    <div class="card-header fw-semibold">
                        Details
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">
                                Condition
                            </label>
                            <select id="create_condition"
                                    class="form-select">
                                <option value="">
                                    -- Select Condition --
                                </option>
                                <option>New</option>
                                <option>Opened - Never Used</option>
                                <option>Used</option>
                                <option>Defective</option>
                                <option>Disposed</option>
                                <option>Discontinued</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div id="createErrorMsg"
                     class="alert alert-danger d-none">
                </div>

            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button"
                        class="btn btn-primary"
                        id="btnCreateSave">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>