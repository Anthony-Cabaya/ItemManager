@model ItemManager.Core.Helpers.PagedResult<Item>
@{
    var search = ViewData["Search"]?.ToString() ?? "";
    var sortCol = ViewData["SortColumn"]?.ToString() ?? "Sort";
    var sortDir = ViewData["SortDirection"]?.ToString() ?? "asc";
    var itemTypeFilter = (int)(ViewData["ItemTypeFilter"] ?? 0);
    var itemTypes = ViewData["ItemTypes"] as IEnumerable<ItemType> ?? new List<ItemType>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Items</h2>
        <a asp-controller="Item" asp-action="Create" class="btn btn-primary">
            Create New
        </a>
    </div>

    @* Search Box *@
    <form asp-action="Index" method="get" class="mb-3" id="searchForm">
        <div class="d-flex gap-2 align-items-center">
            <div class="position-relative" style="max-width: 400px; flex: 1;">
                <input type="text" name="search" id="searchInput"
                       value="@search" class="form-control pe-4"
                       placeholder="@(Context.Session.GetString("Role") == "Admin"
                           ? "Search by name, sort, created by, updated by..."
                           : "Search by name or sort order...")" />

                <input type="hidden" name="sortColumn" value="@sortCol" />
                <input type="hidden" name="sortDirection" value="@sortDir" />

                <span id="clearBtn"
                      style="display:@(!string.IsNullOrEmpty(search) ? "flex" : "none");
                             position:absolute; right:10px; top:50%;
                             transform:translateY(-50%);
                             cursor:pointer; color:#999;
                             align-items:center;"
                      title="Clear">
                    &#x2715;
                </span>
            </div>

            <select name="itemTypeFilter" id="itemTypeFilter" class="form-select w-auto">
                <option value="0">All Types</option>
                @foreach (var type in itemTypes)
                {
                    <option value="@type.ItemTypeID"
                            selected="@(itemTypeFilter == type.ItemTypeID)">
                        @type.ItemTypeName
                    </option>
                }
            </select>
        </div>
    </form>

    @* Item Table *@
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>
                    <span class="@(sortCol == "ItemName" ? "fw-bold text-primary" : "")">Item Name</span>
                    <a asp-action="Index" asp-route-search="@search" asp-route-sortColumn="ItemName" asp-route-sortDirection="asc" asp-route-itemTypeFilter="@itemTypeFilter" class="ms-1 @(sortCol == "ItemName" && sortDir == "asc" ? "text-primary fw-bold" : "text-secondary")">▲</a>
                    <a asp-action="Index" asp-route-search="@search" asp-route-sortColumn="ItemName" asp-route-sortDirection="desc" asp-route-itemTypeFilter="@itemTypeFilter" class="ms-1 @(sortCol == "ItemName" && sortDir == "desc" ? "text-primary fw-bold" : "text-secondary")">▼</a>
                </th>
                <th>
                    <span class="@(sortCol == "Sort" ? "fw-bold text-primary" : "")">Sort Order</span>
                    <a asp-action="Index" asp-route-search="@search" asp-route-sortColumn="Sort" asp-route-sortDirection="asc" asp-route-itemTypeFilter="@itemTypeFilter" class="ms-1 @(sortCol == "Sort" && sortDir == "asc" ? "text-primary fw-bold" : "text-secondary")">▲</a>
                    <a asp-action="Index" asp-route-search="@search" asp-route-sortColumn="Sort" asp-route-sortDirection="desc" asp-route-itemTypeFilter="@itemTypeFilter" class="ms-1 @(sortCol == "Sort" && sortDir == "desc" ? "text-primary fw-bold" : "text-secondary")">▼</a>
                </th>
                <th>
                    <span class="@(sortCol == "ItemTypeName" ? "fw-bold text-primary" : "")">Item Type</span>

                    @* Only show sorting arrows if no filter is applied (i.e., "All Types" is selected) *@
                    @if (itemTypeFilter == 0)
                    {
                        <a asp-action="Index" asp-route-search="@search" asp-route-sortColumn="ItemTypeName" asp-route-sortDirection="asc" asp-route-itemTypeFilter="@itemTypeFilter" class="ms-1 @(sortCol == "ItemTypeName" && sortDir == "asc" ? "text-primary fw-bold" : "text-secondary")">▲</a>
                        <a asp-action="Index" asp-route-search="@search" asp-route-sortColumn="ItemTypeName" asp-route-sortDirection="desc" asp-route-itemTypeFilter="@itemTypeFilter" class="ms-1 @(sortCol == "ItemTypeName" && sortDir == "desc" ? "text-primary fw-bold" : "text-secondary")">▼</a>
                    }
                    else
                    {
                        <span class="text-muted ms-1">▲</span>
                        <span class="text-muted ms-1">▼</span>
                    }
                </th>

                @* Admin Columns *@
                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <th>Created By</th>
                    <th>Created Date</th>
                    <th>Updated By</th>
                    <th>Updated Date</th>
                }

                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.Sort</td>
                    <td>@item.ItemType?.ItemTypeName</td>

                    @* Admin Data *@
                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <td>@item.CreatedBy</td>
                        <td>@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>@(item.UpdatedBy ?? "—")</td>
                        <td>@(item.UpdatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    }

                    <td>
                        <a asp-controller="Item" asp-action="Edit" asp-route-id="@item.ItemID" class="btn btn-sm btn-warning">Edit</a>
                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <a asp-controller="Item" asp-action="Delete" asp-route-id="@item.ItemID" class="btn btn-sm btn-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* Pagination *@
    <nav>
        <ul class="pagination justify-content-center mt-3">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@search" asp-route-sortColumn="@sortCol" asp-route-sortDirection="@sortDir" asp-route-itemTypeFilter="@itemTypeFilter">Previous</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@search" asp-route-sortColumn="@sortCol" asp-route-sortDirection="@sortDir" asp-route-itemTypeFilter="@itemTypeFilter">@i</a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@search" asp-route-sortColumn="@sortCol" asp-route-sortDirection="@sortDir" asp-route-itemTypeFilter="@itemTypeFilter">Next</a>
            </li>
        </ul>
    </nav>

    <p class="text-muted text-center">
        Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount total records)
    </p>
</div>

<style>
    a {
        text-decoration: none;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById('searchInput');
            const clearBtn = document.getElementById('clearBtn');
            const searchForm = document.getElementById('searchForm');
            const itemTypeFilter = document.getElementById('itemTypeFilter');

            if (!searchInput || !clearBtn || !searchForm || !itemTypeFilter) return;

            let debounceTimer;

            searchInput.addEventListener('input', function () {
                clearBtn.style.display = this.value.length > 0 ? 'flex' : 'none';

                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    searchForm.submit();
                }, 400);
            });

            clearBtn.addEventListener('click', function () {
                searchInput.value = '';
                clearBtn.style.display = 'none';
                searchForm.submit();
            });

            itemTypeFilter.addEventListener('change', function () {
                searchForm.submit();
            });

            window.addEventListener('load', () => {
                if (searchInput.value.length > 0) {
                    searchInput.focus();
                    searchInput.setSelectionRange(
                        searchInput.value.length,
                        searchInput.value.length
                    );
                }
            });
        });
    </script>
}