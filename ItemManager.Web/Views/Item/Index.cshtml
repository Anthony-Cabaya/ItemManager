@{
    ViewData["Title"] = "Items";
    var itemTypes = ViewData["ItemTypes"] as IEnumerable<ItemType> ?? new List<ItemType>();
    var isAdmin = ViewData["IsAdmin"] as bool? ?? false;
}

@Html.AntiForgeryToken()

<div id="pageData"
     data-is-admin="@isAdmin.ToString().ToLower()"
     data-item-types='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(itemTypes.Select(x => new { value = x.ItemTypeID, text = x.ItemTypeName })))'>
</div>

<div class="container-fluid px-4">
    @await Html.PartialAsync("Partials/_ItemToolbar", itemTypes)
    @await Html.PartialAsync("Partials/_ItemTable")
    @await Html.PartialAsync("Partials/_ItemCreateModal")
    @await Html.PartialAsync("Partials/_ItemEditModal")
    @await Html.PartialAsync("Partials/_ItemDeleteModal")
</div>

@section Scripts {
    <script src="~/js/shared/fetch-helper.js" asp-append-version="true"></script>
    <script src="~/js/shared/toast.js" asp-append-version="true"></script>
    <script src="~/js/shared/modal-helper.js" asp-append-version="true"></script>
    <script src="~/js/shared/columns.js" asp-append-version="true"></script>

    <script src="~/js/items/item-state.js" asp-append-version="true"></script>
    <script src="~/js/items/item-table.js" asp-append-version="true"></script>
    <script src="~/js/items/item-toolbar.js" asp-append-version="true"></script>
    <script src="~/js/items/item-modals.js" asp-append-version="true"></script>
    <script src="~/js/items/item-init.js" asp-append-version="true"></script>
}