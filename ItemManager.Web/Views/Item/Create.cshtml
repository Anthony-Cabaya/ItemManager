@model ItemViewModel

<div class="container mt-4">
    <h2>Create Item</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="ItemName" class="form-label"></label>
            <input asp-for="ItemName" class="form-control" />
            <span asp-validation-for="ItemName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Sort" class="form-label"></label>
            <input asp-for="Sort" type="number" class="form-control" />
            <span asp-validation-for="Sort" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ItemTypeID" class="form-label">Item Type</label>
            <select asp-for="ItemTypeID" class="form-select" id="itemTypeDropdown"
                    asp-items="Model.ItemTypeOptions">
                <option value="">-- Select Item Type --</option>
            </select>
            <span asp-validation-for="ItemTypeID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ItemSubTypeID" class="form-label"></label>

            @{
                var disableSubType = !Model.SubTypeOptions.Any() ? "disabled" : null;
            }

            <select asp-for="ItemSubTypeID"
                    class="form-select"
                    id="subTypeDropdown"
                    disabled="@disableSubType">
                <option value="">-- Select Sub Type --</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="BaseUnitID" class="form-label"></label>

            <select asp-for="BaseUnitID"
                    class="form-select"
                    id="baseUnitDropdown"
                    asp-items="Model.UnitList">
                <option value="">-- No Unit --</option>
            </select>

            <span asp-validation-for="BaseUnitID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DisplayUnitID" class="form-label"></label>

            <select asp-for="DisplayUnitID"
                    class="form-select"
                    id="displayUnitDropdown"
                    asp-items="Model.UnitList">
                <option value="">-- No Unit --</option>
            </select>

            <span asp-validation-for="DisplayUnitID" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

            const url = '@Url.Action("GetSubTypesByItemType", "Item")';

            $("#itemTypeDropdown").on("change", function () {

                var selectedId = $(this).val();
                var $sub = $("#subTypeDropdown");

                $sub.empty();

                if (!selectedId) {
                    $sub.append('<option value="">-- Select Sub Type --</option>');
                    $sub.prop('disabled', true);
                    return;
                }

                fetch(`${url}?itemTypeId=${selectedId}`)
                    .then(res => res.json())
                    .then(data => {

                        if (!data || data.length === 0) {
                            $sub.append('<option value="">-- No Subcategories Available --</option>');
                            $sub.prop('disabled', true);
                            return;
                        }

                        $sub.prop('disabled', false);
                        $sub.append('<option value="">-- Select Sub Type --</option>');

                        data.forEach(item => {
                            $sub.append(new Option(item.text, item.value));
                        });
                    });
            });

            $("#baseUnitDropdown").on("change", function () {

                const baseValue = $(this).val();
                const display = $("#displayUnitDropdown");

                if (!display.val()) {
                    display.val(baseValue);
                }
            });

        });
    </script>
}