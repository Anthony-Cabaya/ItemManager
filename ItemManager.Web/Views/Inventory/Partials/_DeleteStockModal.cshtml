<div class="modal fade" id="deleteStockModal">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">DELETE STOCK</h5>
            </div>

            <div class="modal-body">

                <div id="delete-stock-error" class="alert alert-danger d-none mb-3"></div>

                @Html.AntiForgeryToken()

                <p>
                    Are you sure you want to remove stock for
                    <strong id="delete-stock-item-name"></strong>
                    at
                    <strong id="delete-stock-location-name"></strong>?
                </p>

                <input type="hidden" id="delete-stock-id" />

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">CANCEL</button>
                <button class="btn btn-danger btn-sm" id="btn-confirm-delete-stock">DELETE</button>
            </div>

        </div>
    </div>
</div>