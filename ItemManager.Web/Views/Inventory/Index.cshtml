<div class="container-fluid px-4">

    <h4 class="mb-3">INVENTORY</h4>

    <div class="d-flex gap-2 mb-2">

        <button class="btn btn-outline-primary btn-sm" id="btn-view-by-item">VIEW BY ITEM</button>
        <button class="btn btn-outline-secondary btn-sm" id="btn-view-by-location">VIEW BY LOCATION</button>

    </div>

    <div class="d-flex justify-content-between mb-2">

        <div id="item-search-wrapper">
            <input type="text" id="item-search-input" class="form-control form-control-sm" placeholder="Search item..." style="width:250px;" />
            <button class="btn btn-outline-secondary btn-sm" id="btn-item-search">Search</button>
        </div>

        <div id="location-filter-wrapper" style="display:none;">
            <select id="location-filter-select" class="form-select form-select-sm" style="width:250px;">
                <option value="">Select Location</option>

                @foreach (var loc in (IEnumerable<ItemManager.Core.Models.Location>)ViewBag.Locations)
                {
                    <option value="@loc.LocationID">@loc.LocationName</option>
                }

            </select>
        </div>

        <div>
            <button class="btn btn-warning btn-sm" id="btn-edit-stock" disabled>EDIT STOCK</button>
            <button class="btn btn-danger btn-sm" id="btn-delete-stock" disabled>DELETE STOCK</button>
        </div>

    </div>

    <div id="stock-table-container" class="border p-3 text-muted">
        Select a filter to view stock.
    </div>

</div>

@await Html.PartialAsync("Partials/_SetStockModal")
@await Html.PartialAsync("Partials/_DeleteStockModal")

@section Scripts {
    <script src="/js/shared/fetch-helper.js"></script>
    <script src="/js/shared/toast.js"></script>
    <script src="/js/shared/modal-helper.js"></script>
    <script src="/js/inventory/inventory-state.js"></script>
    <script src="/js/inventory/inventory-table.js"></script>
    <script src="/js/inventory/inventory-toolbar.js"></script>
    <script src="/js/inventory/inventory-modals.js"></script>
    <script src="/js/inventory/inventory-init.js"></script>
}