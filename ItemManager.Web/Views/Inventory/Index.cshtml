@using ItemManager.Core.Models
@{
    ViewData["Title"] = "Inventory";
}

<style>
    #inventoryTabs {
        border-bottom: 2px solid #94a3b8;
    }

        #inventoryTabs .nav-link {
            color: #64748b;
            font-weight: 500;
            border: 1px solid transparent;
            border-bottom: none;
            border-radius: 6px 6px 0 0;
            padding: 8px 20px;
            background: transparent;
            transition: all 0.15s ease;
        }

            #inventoryTabs .nav-link:hover {
                color: #1e293b;
                background-color: #f1f5f9;
                border-color: #cbd5e1 #cbd5e1 transparent;
            }

            #inventoryTabs .nav-link.active {
                color: #ffffff;
                background-color: #1e293b;
                border-color: #1e293b #1e293b #ffffff;
                font-weight: 600;
            }
</style>

@Html.AntiForgeryToken()

<div class="container-fluid px-4">

    <h4 class="fw-bold text-uppercase mb-3">Inventory</h4>

    <!-- TABS -->
    <ul class="nav nav-tabs mb-3" id="inventoryTabs">

        <li class="nav-item">
            <button class="nav-link active"
                    id="tab-by-item"
                    data-tab="by-item">
                View by Item
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link"
                    id="tab-by-location"
                    data-tab="by-location">
                View by Location
            </button>
        </li>

    </ul>

    <!-- VIEW BY ITEM TAB CONTENT -->
    <div id="pane-by-item">

        <div class="d-flex gap-2 align-items-center mb-2 flex-wrap">

            <div class="position-relative" style="width:250px;">
                <input type="text"
                       id="item-search-input"
                       class="form-control form-control-sm"
                       placeholder="Search item..." />
                <span id="item-search-clear"
                      style="position:absolute; right:8px; top:50%;
                             transform:translateY(-50%);
                             cursor:pointer; display:none; color:#999;">
                    ✕
                </span>
            </div>

            <button class="btn btn-outline-secondary btn-sm"
                    id="btn-item-search">
                Search
            </button>

        </div>

        <div class="d-flex gap-2 align-items-center mb-3">
            <button class="btn btn-warning btn-sm"
                    id="btn-edit-stock"
                    disabled>
                EDIT STOCK
            </button>

            <button class="btn btn-danger btn-sm"
                    id="btn-delete-stock"
                    disabled>
                DELETE STOCK
            </button>
        </div>

        <div style="overflow-x:auto;">
            <div id="stock-table-container">
                <div class="text-muted text-center py-4">
                    Search for an item to view stock.
                </div>
            </div>
        </div>

    </div>

    <!-- VIEW BY LOCATION TAB CONTENT -->
    <div id="pane-by-location" style="display:none;">

        <div class="d-flex gap-2 align-items-center mb-2 flex-wrap">

            <select id="location-filter-select"
                    class="form-select form-select-sm"
                    style="width:250px;">

                <option value="">Select Location</option>

                @foreach (var loc in (IEnumerable<Location>)ViewBag.Locations)
                {
                    <option value="@loc.LocationID">@loc.LocationName</option>
                }

            </select>

        </div>

        <div class="d-flex gap-2 align-items-center mb-3">
            <button class="btn btn-warning btn-sm"
                    id="btn-edit-stock-loc"
                    disabled>
                EDIT STOCK
            </button>

            <button class="btn btn-danger btn-sm"
                    id="btn-delete-stock-loc"
                    disabled>
                DELETE STOCK
            </button>
        </div>

        <div style="overflow-x:auto;">
            <div id="stock-location-container">
                <div class="text-muted text-center py-4">
                    Select a location to view stock.
                </div>
            </div>
        </div>

    </div>

</div>

@await Html.PartialAsync("Partials/_SetStockModal")
@await Html.PartialAsync("Partials/_DeleteStockModal")

@section Scripts {

    <script src="~/js/shared/fetch-helper.js" asp-append-version="true"></script>
    <script src="~/js/shared/toast.js" asp-append-version="true"></script>
    <script src="~/js/shared/modal-helper.js" asp-append-version="true"></script>

    <script src="~/js/inventory/inventory-state.js" asp-append-version="true"></script>
    <script src="~/js/inventory/inventory-table.js" asp-append-version="true"></script>
    <script src="~/js/inventory/inventory-toolbar.js" asp-append-version="true"></script>
    <script src="~/js/inventory/inventory-modals.js" asp-append-version="true"></script>
    <script src="~/js/inventory/inventory-init.js" asp-append-version="true"></script>
}