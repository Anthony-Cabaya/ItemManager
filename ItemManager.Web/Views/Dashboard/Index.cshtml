@model ItemManager.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h2>Dashboard</h2>

    <div class="row row-cols-1 row-cols-md-3 g-3 mt-3">

        <!-- Row 1 -->
        <div class="col">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <div class="display-6 fw-bold text-primary">@Model.TotalItems</div>
                    <div class="text-muted mt-1">Total Items</div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <div class="display-6 fw-bold text-primary">@Model.ItemsThisMonth</div>
                    <div class="text-muted mt-1">Items Added This Month</div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <div class="display-6 fw-bold @Model.ItemsWithoutUnitCssClass">@Model.ItemsWithoutUnit</div>
                    <div class="text-muted mt-1">Items Without Unit</div>
                </div>
            </div>
        </div>

        <!-- Row 2 -->
        <div class="col">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <div class="display-6 fw-bold @Model.ItemsWithoutSubTypeCssClass">@Model.ItemsWithoutSubType</div>
                    <div class="text-muted mt-1">Items Without SubType</div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <div class="display-6 fw-bold text-primary">@Model.TotalUnits</div>
                    <div class="text-muted mt-1">Total Units</div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <div class="display-6 fw-bold text-primary">@Model.TotalUnitCategories</div>
                    <div class="text-muted mt-1">Total Unit Categories</div>
                </div>
            </div>
        </div>

    </div>
</div>