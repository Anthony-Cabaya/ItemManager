<div class="modal fade"
     id="createModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Create Item Type
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <div id="createErrorMsg"
                     class="alert alert-danger d-none mb-3"></div>

                <div class="mb-3">

                    <label class="form-label">
                        Item Type Name *
                    </label>

                    <input type="text"
                           id="create_itemTypeName"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Sort
                    </label>

                    <input type="number"
                           id="create_sort"
                           value="0"
                           class="form-control" />

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-primary"
                        id="btnCreateSave">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>