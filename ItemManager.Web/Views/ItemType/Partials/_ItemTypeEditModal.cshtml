<div class="modal fade"
     id="editModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Edit Item Type
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="edit_itemTypeID" />

                <div id="editErrorMsg"
                     class="alert alert-danger d-none mb-3"></div>

                <div class="mb-3">

                    <label class="form-label">
                        Item Type Name *
                    </label>

                    <input type="text"
                           id="edit_itemTypeName"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Sort
                    </label>

                    <input type="number"
                           id="edit_sort"
                           value="0"
                           class="form-control" />

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-primary"
                        id="btnEditSave">
                    Update
                </button>

            </div>

        </div>

    </div>

</div>