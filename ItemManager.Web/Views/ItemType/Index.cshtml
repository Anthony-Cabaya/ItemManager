@model ItemManager.Core.Helpers.PagedResult<ItemType>
@{
    ViewData["Title"] = "Item Types";

    var search = ViewData["Search"]?.ToString() ?? "";
    var sortCol = ViewData["SortColumn"]?.ToString() ?? "Sort";
    var sortDir = ViewData["SortDirection"]?.ToString() ?? "asc";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Item Types</h2>
        <a asp-controller="ItemType" asp-action="Create" class="btn btn-primary">
            Create New
        </a>
    </div>

    @* Search *@
    <form asp-action="Index" method="get" class="mb-3" id="searchForm">
        <div class="position-relative" style="max-width: 400px;">
            <input type="text"
                   name="search"
                   id="searchInput"
                   value="@search"
                   class="form-control pe-4"
                   placeholder="@(Context.Session.GetString("Role") == "Admin"
                       ? "Search by name, sort, created by, updated by..."
                       : "Search by name or sort...")" />

            <input type="hidden" name="sortColumn" value="@sortCol" />
            <input type="hidden" name="sortDirection" value="@sortDir" />

            @* X CLEAR BUTTON *@
            <span id="clearBtn"
                  style="display:@(!string.IsNullOrEmpty(search) ? "flex" : "none");
                         position:absolute;
                         right:10px;
                         top:50%;
                         transform:translateY(-50%);
                         cursor:pointer;
                         color:#999;
                         align-items:center;"
                  title="Clear">
                &#x2715;
            </span>
        </div>
    </form>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>

                @* Item type name *@
                <th>
                    <span class="@(sortCol == "ItemTypeName" ? "fw-bold text-primary" : "")">
                        Item Type Name
                    </span>

                    <a asp-action="Index"
                       asp-route-search="@search"
                       asp-route-sortColumn="ItemTypeName"
                       asp-route-sortDirection="asc"
                       asp-route-page="1"
                       class="ms-1 @(sortCol == "ItemTypeName" && sortDir == "asc" ? "text-primary fw-bold" : "text-secondary")">
                        ▲
                    </a>

                    <a asp-action="Index"
                       asp-route-search="@search"
                       asp-route-sortColumn="ItemTypeName"
                       asp-route-sortDirection="desc"
                       asp-route-page="1"
                       class="ms-1 @(sortCol == "ItemTypeName" && sortDir == "desc" ? "text-primary fw-bold" : "text-secondary")">
                        ▼
                    </a>
                </th>

                @* Sort order *@
                <th>
                    <span class="@(sortCol == "Sort" ? "fw-bold text-primary" : "")">
                        Sort Order
                    </span>

                    <a asp-action="Index"
                       asp-route-search="@search"
                       asp-route-sortColumn="Sort"
                       asp-route-sortDirection="asc"
                       asp-route-page="1"
                       class="ms-1 @(sortCol == "Sort" && sortDir == "asc" ? "text-primary fw-bold" : "text-secondary")">
                        ▲
                    </a>

                    <a asp-action="Index"
                       asp-route-search="@search"
                       asp-route-sortColumn="Sort"
                       asp-route-sortDirection="desc"
                       asp-route-page="1"
                       class="ms-1 @(sortCol == "Sort" && sortDir == "desc" ? "text-primary fw-bold" : "text-secondary")">
                        ▼
                    </a>
                </th>

                @* Admin Columns *@
                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <th>Created By</th>
                    <th>Created Date</th>
                    <th>Updated By</th>
                    <th>Updated Date</th>
                }

                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ItemTypeName</td>
                    <td>@item.Sort</td>

                    @* Admin Data *@
                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <td>@item.CreatedBy</td>
                        <td>@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>@(item.UpdatedBy ?? "—")</td>
                        <td>@(item.UpdatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    }

                    <td>
                        <a asp-controller="ItemType"
                           asp-action="Edit"
                           asp-route-id="@item.ItemTypeID"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* Pagination *@
    <nav>
        <ul class="pagination justify-content-center mt-3">

            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.PageNumber - 1)"
                   asp-route-search="@search"
                   asp-route-sortColumn="@sortCol"
                   asp-route-sortDirection="@sortDir">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@search"
                       asp-route-sortColumn="@sortCol"
                       asp-route-sortDirection="@sortDir">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.PageNumber + 1)"
                   asp-route-search="@search"
                   asp-route-sortColumn="@sortCol"
                   asp-route-sortDirection="@sortDir">
                    Next
                </a>
            </li>

        </ul>
    </nav>

    <p class="text-muted text-center">
        Showing page @Model.PageNumber of @Model.TotalPages
        (@Model.TotalCount total records)
    </p>

</div>

<style>
    a {
        text-decoration: none;
    }

    /* Active sort column highlighting */
    a.active {
        font-weight: bold;
        color: #007bff;
    }

    #searchInput::-ms-clear {
        display: none;
    }
</style>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const clearBtn = document.getElementById('clearBtn');
        const searchForm = document.getElementById('searchForm');

        let debounceTimer;

        searchInput.addEventListener('input', function () {
            clearBtn.style.display = this.value.length > 0 ? 'flex' : 'none';

            clearTimeout(debounceTimer);

            debounceTimer = setTimeout(() => {
                searchForm.submit();
            }, 400);
        });

        clearBtn.addEventListener('click', function () {
            searchInput.value = '';
            clearBtn.style.display = 'none';
            searchForm.submit();
        });

        window.addEventListener('load', () => {
            if (searchInput.value.length > 0) {
                searchInput.focus();

                searchInput.setSelectionRange(
                    searchInput.value.length,
                    searchInput.value.length
                );
            }
        });
    </script>
}
