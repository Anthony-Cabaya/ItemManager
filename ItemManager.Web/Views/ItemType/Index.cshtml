@{
    ViewData["Title"] = "Item Types";
}

<div id="pageData"
     data-is-admin="@((ViewBag.IsAdmin ?? false) ? "true" : "false")">
</div>

@Html.AntiForgeryToken()

<div class="container-fluid px-4">
    <h4 class="fw-bold text-uppercase mb-3">Item Type Management</h4>

    @await Html.PartialAsync("Partials/_ItemTypeToolbar")
    @await Html.PartialAsync("Partials/_ItemTypeTable")
    @await Html.PartialAsync("Partials/_ItemTypeCreateModal")
    @await Html.PartialAsync("Partials/_ItemTypeEditModal")
    @await Html.PartialAsync("Partials/_ItemTypeDeleteModal")

</div>

@section Scripts {

    <script src="~/js/shared/fetch-helper.js"></script>
    <script src="~/js/shared/toast.js"></script>
    <script src="~/js/shared/modal-helper.js"></script>

    <script src="~/js/item-types/item-type-state.js"></script>
    <script src="~/js/item-types/item-type-table.js"></script>
    <script src="~/js/item-types/item-type-toolbar.js"></script>
    <script src="~/js/item-types/item-type-modals.js"></script>
    <script src="~/js/item-types/item-type-init.js"></script>
}