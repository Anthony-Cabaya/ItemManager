@{
    ViewData["Title"] = "Unit Categories";
}

<div id="pageData"
     data-is-admin="@((ViewBag.IsAdmin ?? false) ? "true" : "false")">
</div>

@Html.AntiForgeryToken()

<div class="container-fluid px-4">
    <h4 class="fw-bold text-uppercase mb-3">Unit Category Management</h4>

    @await Html.PartialAsync("Partials/_CategoryToolbar")
    @await Html.PartialAsync("Partials/_CategoryTable")
    @await Html.PartialAsync("Partials/_CategoryCreateModal")
    @await Html.PartialAsync("Partials/_CategoryEditModal")
    @await Html.PartialAsync("Partials/_CategoryDeleteModal")

</div>

@section Scripts {

    <script src="~/js/shared/fetch-helper.js">
    </script>

    <script src="~/js/shared/toast.js">
    </script>

    <script src="~/js/shared/modal-helper.js">
    </script>

    <script src="~/js/unit-categories/category-state.js">
    </script>

    <script src="~/js/unit-categories/category-table.js">
    </script>

    <script src="~/js/unit-categories/category-toolbar.js">
    </script>

    <script src="~/js/unit-categories/category-modals.js">
    </script>

    <script src="~/js/unit-categories/category-init.js">
    </script>
}