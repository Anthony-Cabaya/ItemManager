@model ItemManager.Web.ViewModels.UnitCategoryViewModel

@{
    ViewData["Title"] = "Edit Unit Category";
}

<h2>Edit Unit Category</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="UnitCategoryID" />

    <div class="form-group mb-3">
        <label asp-for="CategoryName"></label>
        <input asp-for="CategoryName" class="form-control" />
        <span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Sort"></label>
        <input asp-for="Sort" class="form-control" />
        <span asp-validation-for="Sort" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
