<div class="modal fade"
     id="editModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Edit Category
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="edit_categoryID" />

                <input type="hidden"
                       id="edit_isSystem" />

                <div id="editErrorMsg"
                     class="alert alert-danger d-none mb-3">
                </div>

                <div id="systemWarning"
                     class="alert alert-warning d-none mb-3">

                    This is a system category.
                    Only Sort Order can be modified.

                </div>

                <div class="mb-2">

                    <label class="form-label">
                        Category Name
                    </label>

                    <input type="text"
                           id="edit_categoryName"
                           class="form-control" />

                </div>

                <div>

                    <label class="form-label">
                        Sort
                    </label>

                    <input type="number"
                           id="edit_sort"
                           value="0"
                           class="form-control" />

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="btnEditSave"
                        class="btn btn-primary">
                    UPDATE
                </button>

            </div>

        </div>

    </div>

</div>