<div class="modal fade"
     id="createModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Create Category
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div id="createErrorMsg"
                     class="alert alert-danger d-none mb-3">
                </div>

                <div class="mb-2">

                    <label class="form-label">
                        Category Name *
                    </label>

                    <input type="text"
                           id="create_categoryName"
                           class="form-control" />

                </div>

                <div>

                    <label class="form-label">
                        Sort
                    </label>

                    <input type="number"
                           id="create_sort"
                           value="0"
                           class="form-control" />

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="btnCreateSave"
                        class="btn btn-primary">
                    SAVE
                </button>

            </div>

        </div>

    </div>

</div>