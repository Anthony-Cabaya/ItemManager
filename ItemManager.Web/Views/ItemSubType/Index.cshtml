@{
    ViewData["Title"] = "Sub Types";
}

<div id="pageData"
     data-is-admin="@((ViewBag.IsAdmin ?? false) ? "true" : "false")"
     data-item-types='@Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            (ViewBag.ItemTypes as IEnumerable<ItemManager.Core.Models.ItemType>
             ?? new List<ItemManager.Core.Models.ItemType>())
            .Select(x => new {
                value = x.ItemTypeID,
                text = x.ItemTypeName
            })
        ))'>
</div>

@Html.AntiForgeryToken()

<div class="container-fluid px-4">
    <h4 class="fw-bold text-uppercase mb-3">Sub Type Management</h4>

    @await Html.PartialAsync("Partials/_SubTypeToolbar")
    @await Html.PartialAsync("Partials/_SubTypeTable")
    @await Html.PartialAsync("Partials/_SubTypeCreateModal")
    @await Html.PartialAsync("Partials/_SubTypeEditModal")
    @await Html.PartialAsync("Partials/_SubTypeDeleteModal")

</div>

@section Scripts {
    <script src="~/js/shared/fetch-helper.js"></script>
    <script src="~/js/shared/toast.js"></script>
    <script src="~/js/shared/modal-helper.js"></script>

    <script src="~/js/item-subtypes/sub-type-state.js"></script>
    <script src="~/js/item-subtypes/sub-type-table.js"></script>
    <script src="~/js/item-subtypes/sub-type-toolbar.js"></script>
    <script src="~/js/item-subtypes/sub-type-modals.js"></script>
    <script src="~/js/item-subtypes/sub-type-init.js"></script>
}