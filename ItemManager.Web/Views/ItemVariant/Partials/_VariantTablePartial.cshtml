@model List<ItemVariantViewModel>

@if (Model == null || !Model.Any())
{
    <table class="table table-hover table-bordered align-middle table-sm"
           style="font-size:13px;">

        <thead class="table-light">
            <tr>
                <th style="width:36px;"></th>
                <th>Variant Code</th>
                <th>Variant Name</th>
                <th>Attributes</th>
                <th>Quantity</th>
                <th>Reserved</th>
                <th>Available</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td colspan="8"
                    class="text-center text-muted py-4">
                    No variants found.
                </td>
            </tr>
        </tbody>

    </table>
}
else
{
    <table class="table table-hover table-bordered align-middle table-sm"
           style="font-size:13px;">

        <thead class="table-light">
            <tr>
                <th style="width:36px;"></th>
                <th>Variant Code</th>
                <th>Variant Name</th>
                <th>Attributes</th>
                <th>Quantity</th>
                <th>Reserved</th>
                <th>Available</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var v in Model)
            {
                var attributes =
                v.AttributeValues ??
                new List<ItemAttributeValueViewModel>();

                var attrLines = string.Join("\n",
                attributes.Select(a =>
                $"{a.AttributeName}: {a.ValueLabel}"));

                var displayText =
                !string.IsNullOrWhiteSpace(attrLines)
                ? attrLines
                : v.AttributesText ?? "";

                <tr class="variant-row"
                    data-id="@v.ItemVariantID"
                    data-item-id="@v.ItemID"
                    data-variant-code="@v.VariantCode"
                    data-variant-name="@v.VariantName"
                    data-is-active="@v.IsActive.ToString().ToLower()"
                    data-sort="@v.Sort"
                    data-quantity="@v.Quantity"
                    data-reserved="@v.ReservedQuantity"
                    data-available="@v.AvailableQuantity"
                    data-attributes="@displayText">

                    <td>
                        <input type="checkbox"
                               class="variant-select"
                               value="@v.ItemVariantID" />
                    </td>

                    <td class="fw-semibold font-monospace">
                        @v.VariantCode
                    </td>

                    <td>
                        @v.VariantName
                    </td>

                    <td style="max-width:220px;
                                       white-space:pre-line;
                                       word-break:break-word;
                                       font-size:12px;
                                       line-height:1.4;">

                        @if (!string.IsNullOrWhiteSpace(displayText))
                        {
                            @displayText
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }

                    </td>

                    <td>@v.Quantity</td>

                    <td>@v.ReservedQuantity</td>

                    <td>@v.AvailableQuantity</td>

                    <td>
                        @if (v.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }
                    </td>

                </tr>
            }

        </tbody>

    </table>
}