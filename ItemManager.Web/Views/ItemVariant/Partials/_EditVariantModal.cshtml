<div class="modal fade" id="editVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title text-uppercase fw-bold">
                    EDIT VARIANT
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <div id="edit-variant-error"
                     class="alert alert-danger mb-3"
                     style="visibility:hidden;min-height:0;padding:0;margin:0;border:none;">
                </div>

                <input type="hidden" id="variant-edit-id" />
                <input type="hidden" id="variant-edit-item-id" />
                <input type="hidden" id="variant-edit-original-code" />

                <div class="mb-2">
                    <label class="form-label text-uppercase small">
                        Variant Code
                    </label>

                    <input type="text"
                           id="variant-edit-code"
                           class="form-control form-control-sm"
                           maxlength="100"
                           required />

                    <div class="form-text text-muted small">
                        Changing the code may affect transaction history.
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label text-uppercase small">
                        Variant Name
                    </label>

                    <input type="text"
                           id="variant-edit-name"
                           class="form-control form-control-sm"
                           maxlength="255"
                           required />
                </div>

                <div class="mb-2">
                    <label class="form-label text-uppercase small">
                        Attributes
                    </label>

                    <textarea id="variant-edit-attributes"
                              class="form-control form-control-sm"
                              rows="3"
                              placeholder="e.g. Color: Grey, Size: US 10, Material: Mesh"
                              style="resize:vertical;line-height:1.3;"></textarea>

                    <div class="form-text text-muted small">
                        Optional. Format: Key: Value, Key: Value.
                    </div>
                </div>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input"
                           type="checkbox"
                           id="variant-edit-is-active" />

                    <label class="form-check-label text-uppercase small">
                        Active
                    </label>
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-warning btn-sm text-uppercase"
                        id="btn-update-variant">
                    UPDATE
                </button>

                <button type="button"
                        class="btn btn-secondary btn-sm text-uppercase"
                        data-bs-dismiss="modal">
                    CANCEL
                </button>

            </div>

        </div>
    </div>
</div>