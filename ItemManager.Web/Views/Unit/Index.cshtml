@model List<ItemManager.Web.ViewModels.UnitCategoryViewModel>

@{
    ViewData["Title"] = "Units";
}

<div class="container-fluid px-4">
    <h4 class="fw-bold text-uppercase mb-3">Unit Management</h4>

    <!-- ERROR MESSAGE -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row">

        <!-- LEFT: CATEGORY PANEL -->
        <div class="col-3">

            <div class="card"
                 style="box-shadow: 0 1px 4px rgba(0,0,0,0.08);">

                <div class="card-header fw-bold">
                    Unit Categories
                </div>

                <div class="card-body p-2">

                    <div id="category-list">

                        @foreach (var c in Model)
                        {
                            <div class="p-2 mb-1 category-item"
                                 data-category-id="@c.UnitCategoryID"
                                 data-is-system="@c.IsSystem"
                                 data-name="@c.CategoryName"
                                 style="cursor:pointer;">

                                <div class="d-flex justify-content-between align-items-center">

                                    <span>@c.CategoryName</span>

                                </div>

                            </div>
                        }

                    </div>

                </div>
            </div>

        </div>

        <!-- RIGHT: UNIT PANEL -->
        <div class="col-9">
                <!-- SEARCH ROW -->
            <div class="d-flex justify-content-start mb-2">

                    <div style="position:relative; width:250px;">
                        <input type="text"
                               id="unit-search"
                               class="form-control form-control-sm"
                               placeholder="Search units..." />

                        <span id="unit-search-clear"
                              style="position:absolute;
                                     right:8px;
                                     top:50%;
                                     transform:translateY(-50%);
                                     cursor:pointer;
                                     display:none;">
                            ✕
                        </span>
                    </div>

                    <button id="btn-search-unit"
                            class="btn btn-outline-secondary btn-sm ms-2">
                        Search
                    </button>

            </div>

            <!-- ACTION ROW -->
            <div class="d-flex justify-content-start mb-2">

                <button id="btn-create-unit"
                        class="btn btn-primary btn-sm me-1">
                    CREATE
                </button>

                <button id="btn-edit-unit"
                        class="btn btn-warning btn-sm me-1"
                        disabled>
                    EDIT
                </button>

                <button id="btn-delete-unit"
                        class="btn btn-danger btn-sm"
                        disabled>
                    DELETE
                </button>

            </div>

            @Html.AntiForgeryToken()

            <!-- TABLE AREA -->
            <div id="unit-table-container"
                 class="border rounded p-2 bg-white">

                <div class="text-muted text-center py-4">
                    Select a category to view units.
                </div>

            </div>

        </div>

    </div>

</div>

<!-- MODALS -->
@await Html.PartialAsync("Partials/_UnitCreateModal")
@await Html.PartialAsync("Partials/_UnitEditModal")
@await Html.PartialAsync("Partials/_UnitDeleteModal")

@section Scripts {
    <script src="/js/shared/fetch-helper.js"></script>
    <script src="/js/shared/toast.js"></script>
    <script src="/js/shared/modal-helper.js"></script>
    <script src="/js/units/unit-state.js"></script>
    <script src="/js/units/unit-category.js"></script>
    <script src="/js/units/unit-table.js"></script>
    <script src="/js/units/unit-toolbar.js"></script>
    <script src="/js/units/unit-modals.js"></script>
    <script src="/js/units/unit-init.js"></script>
}