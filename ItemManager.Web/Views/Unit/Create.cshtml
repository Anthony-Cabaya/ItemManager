@model ItemManager.Web.ViewModels.UnitViewModel

@{
    ViewData["Title"] = "Create Unit";
}

<h2>Create Unit</h2>

<form asp-action="Create" method="post">

    <div class="form-group mb-3">
        <label asp-for="UnitName"></label>
        <input asp-for="UnitName" class="form-control" />
        <span asp-validation-for="UnitName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Abbreviation"></label>
        <input asp-for="Abbreviation" class="form-control" />
        <span asp-validation-for="Abbreviation" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Category</label>
        <select asp-for="UnitCategoryID"
                asp-items="Model.UnitCategoryList"
                class="form-control">
        </select>
        <span asp-validation-for="UnitCategoryID" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Sort"></label>
        <input asp-for="Sort" class="form-control" />
        <span asp-validation-for="Sort" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
